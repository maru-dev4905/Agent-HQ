{
  "name": "agent-hq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "generate": "pnpm --filter @agent-hq/database generate",
    "build": "pnpm generate && tsc -b && pnpm --filter @agent-hq/web build",
    "typecheck": "pnpm generate && tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.tools.json && pnpm --filter @agent-hq/web typecheck",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm generate && vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @agent-hq/database migrate:deploy",
    "dev:api": "pnpm --filter @agent-hq/api dev",
    "dev:web": "pnpm --filter @agent-hq/web dev",
    "test:integration": "pnpm generate && vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm infra:up && pnpm build && playwright test",
    "measure:load": "pnpm generate && vitest run --config vitest.load.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
