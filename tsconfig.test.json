{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.test.ts",
    "apps/api/test/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "apps/api/src/**/*.test-helpers.ts"
  ]
}
