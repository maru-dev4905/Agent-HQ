# Local development only. Copy to .env and adjust. Never commit .env.
# These defaults match docker-compose.yml and are not secrets.
POSTGRES_USER=agent_hq
POSTGRES_PASSWORD=agent_hq_local
POSTGRES_DB=agent_hq
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent_hq:agent_hq_local@127.0.0.1:5432/agent_hq?schema=public

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

API_HOST=127.0.0.1
API_PORT=4000

# Connections (HQ-103). Defaults shown.
# CONNECTION_TOKEN_TTL_DAYS=30
# HEARTBEAT_DEGRADED_MS=30000
# HEARTBEAT_DISCONNECTED_MS=90000
# HEALTH_CHECK_INTERVAL_MS=10000   # 0 disables the background health job

# HTTP (HQ-105). Loopback host names are always allowed; add others comma-separated.
# API_ALLOWED_HOSTS=
# Browser origins allowed to call the API (exact match). Empty: every request with Origin is rejected.
# API_ALLOWED_ORIGINS=

# Ingestion rate limit per connection, counted in events (HQ-105). Defaults shown.
# INGEST_RATE_EVENTS_PER_SECOND=500
# INGEST_RATE_BURST_EVENTS=2000   # must be at least 500 (one full batch)

# Realtime (HQ-107). Defaults shown.
# OUTBOX_POLL_INTERVAL_MS=200     # 0 disables the outbox relay (streams still catch up on their own)
# SSE_MAX_STREAMS=100
# SSE_KEEP_ALIVE_MS=15000
# SSE_CATCH_UP_INTERVAL_MS=5000

# Gap detection and stale display (HQ-108). Defaults shown.
# GAP_CHECK_INTERVAL_MS=10000   # 0 disables gap detection
# GAP_GRACE_MS=30000            # how long a sequence hole may stay open before it is recorded
# STALE_THRESHOLD_MS=300000     # agents with nothing received for this long are shown as stale
