// Agent HQ database schema. Prisma is pinned to 7.10.x (ADR-0003, TD-003).
// Raw SQL and Prisma Client usage stay inside packages/database (coding-standards §2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Top-level workspace (spec domain-model §2). Phase 1 runs a single local workspace.
model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  connections       Connection[]
  registrationCodes RegistrationCode[]
  events            Event[]
  agentInstances    AgentInstance[]
  tasks             Task[]

  @@map("workspaces")
}

/// Runtime or bridge connection (spec domain-model AgentConnection). HQ-103 adds auth columns.
model Connection {
  id              String    @id
  workspaceId     String    @map("workspace_id")
  adapterId       String    @map("adapter_id")
  runtime         String
  displayName     String?   @map("display_name")
  /// pending | connected | degraded | disconnected | error (spec domain-model §4)
  status          String    @default("pending")
  /// SHA-256 of the connection token; the token itself is never stored (HQ-103).
  tokenHash       String    @unique @map("token_hash")
  tokenExpiresAt  DateTime  @map("token_expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  events         Event[]
  agentInstances AgentInstance[]
  tasks          Task[]

  /// Lets child rows reference (id, workspaceId) so a connection can never be used by another workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("connections")
}

/// HQ identity for an external agent: (workspace, connection, externalAgentId) is unique (ADR-0006).
model AgentInstance {
  id              String   @id
  workspaceId     String   @map("workspace_id")
  connectionId    String   @map("connection_id")
  externalAgentId String   @map("external_agent_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id])
  connection Connection         @relation(fields: [connectionId, workspaceId], references: [id, workspaceId])
  state      AgentCurrentState?

  @@unique([workspaceId, connectionId, externalAgentId])
  /// Lets read models reference (id, workspaceId) so a row can never belong to another workspace.
  @@unique([id, workspaceId])
  @@map("agent_instances")
}

/// HQ identity for an external task: (workspace, connection, externalTaskId) is unique (ADR-0006).
model Task {
  id             String   @id
  workspaceId    String   @map("workspace_id")
  connectionId   String   @map("connection_id")
  externalTaskId String   @map("external_task_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id])
  connection Connection        @relation(fields: [connectionId, workspaceId], references: [id, workspaceId])
  state      TaskCurrentState?

  @@unique([workspaceId, connectionId, externalTaskId])
  /// Lets read models reference (id, workspaceId) so a row can never belong to another workspace.
  @@unique([id, workspaceId])
  @@map("tasks")
}

/// Append-only event log (ADR-0002). Rows are never updated; `storeSequence` is the replay cursor.
model Event {
  storeSequence     BigInt   @id @default(autoincrement()) @map("store_sequence")
  id                String
  workspaceId       String   @map("workspace_id")
  connectionId      String   @map("connection_id")
  idempotencyKey    String   @map("idempotency_key")
  /// SHA-256 of the canonical event body, used to detect same-key/different-content conflicts.
  contentHash       String   @map("content_hash")
  schemaVersion     Int      @map("schema_version")
  type              String
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt        DateTime @map("received_at") @db.Timestamptz(3)
  timestampQuality  String?  @map("timestamp_quality")
  agentInstanceId   String?  @map("agent_instance_id")
  taskId            String?  @map("task_id")
  projectId         String?  @map("project_id")
  missionId         String?  @map("mission_id")
  pipelineRunId     String?  @map("pipeline_run_id")
  nodeRunId         String?  @map("node_run_id")
  correlationId     String   @map("correlation_id")
  causationId       String?  @map("causation_id")
  externalSessionId String?  @map("external_session_id")
  sequence          Int?
  sensitivity       String?
  source            Json
  payload           Json

  workspace  Workspace    @relation(fields: [workspaceId], references: [id])
  connection Connection   @relation(fields: [connectionId, workspaceId], references: [id, workspaceId])
  outbox     EventOutbox?

  @@unique([workspaceId, connectionId, idempotencyKey])
  /// Event IDs may come from sources, so uniqueness is per workspace (no cross-tenant collisions).
  @@unique([workspaceId, id])
  @@index([workspaceId, storeSequence])
  @@index([connectionId, externalSessionId, sequence])
  @@map("events")
}

/// Transactional outbox: a row per stored event, written in the same transaction (ADR-0002).
/// It only signals "new events exist"; replay always reads from `events`.
model EventOutbox {
  storeSequence BigInt   @id @map("store_sequence")
  workspaceId   String   @map("workspace_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [storeSequence], references: [storeSequence])

  @@index([workspaceId, storeSequence])
  @@map("event_outbox")
}

/// One-time code a user creates locally to register a connection (security §5). Stored hashed.
model RegistrationCode {
  id          String    @id
  workspaceId String    @map("workspace_id")
  codeHash    String    @unique @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("registration_codes")
}

/// Read model: current state per agent, derived only from events (ADR-0002). Rebuildable.
/// `orderKeys` records which event set each field group, so arrival order does not matter.
model AgentCurrentState {
  agentInstanceId       String   @id @map("agent_instance_id")
  workspaceId           String   @map("workspace_id")
  connectionId          String   @map("connection_id")
  observedStatus        String   @map("observed_status")
  rawStatus             String?  @map("raw_status")
  agentName             String?  @map("agent_name")
  roleHint              String?  @map("role_hint")
  parentExternalAgentId String?  @map("parent_external_agent_id")
  executionLocation     String?  @map("execution_location")
  lastEventType         String   @map("last_event_type")
  lastEventAt           DateTime @map("last_event_at") @db.Timestamptz(3)
  /// Server receive time of the latest event (HQ-108 stale detection must not trust source clocks).
  lastReceivedAt        DateTime @map("last_received_at") @db.Timestamptz(3)
  lastStoreSequence     BigInt   @map("last_store_sequence")
  orderKeys             Json     @map("order_keys")

  agentInstance AgentInstance @relation(fields: [agentInstanceId, workspaceId], references: [id, workspaceId])

  @@unique([agentInstanceId, workspaceId])
  @@index([workspaceId])
  @@map("agent_current_state")
}

/// Read model: current state per task, derived only from events (ADR-0002). Rebuildable.
model TaskCurrentState {
  taskId               String   @id @map("task_id")
  workspaceId          String   @map("workspace_id")
  connectionId         String   @map("connection_id")
  agentInstanceId      String?  @map("agent_instance_id")
  status               String
  title                String?
  parentExternalTaskId String?  @map("parent_external_task_id")
  lastEventType        String   @map("last_event_type")
  lastEventAt          DateTime @map("last_event_at") @db.Timestamptz(3)
  /// Server receive time of the latest event (HQ-108 stale detection must not trust source clocks).
  lastReceivedAt       DateTime @map("last_received_at") @db.Timestamptz(3)
  lastStoreSequence    BigInt   @map("last_store_sequence")
  orderKeys            Json     @map("order_keys")

  task Task @relation(fields: [taskId, workspaceId], references: [id, workspaceId])

  @@unique([taskId, workspaceId])
  @@index([workspaceId])
  @@map("task_current_state")
}
